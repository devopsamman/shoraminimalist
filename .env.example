# Stripe → Shopify Integration Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# Stripe
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Get from: https://dashboard.stripe.com/webhooks (after creating the endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# Shopify
# Your store's myshopify.com domain (without https://)
# Example: my-store.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Get from: Shopify Admin → Settings → Apps → Develop apps → Your App → API credentials
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_...
